{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>marvinvr/renovate-config"],
  "customManagers": [
    {
      "description": "serve installed globally in the Dockerfile runtime stage.",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["npm install -g [^\\n]*?(?<depName>serve)@(?<currentValue>[0-9][^\\s]*)"],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Angular 15 peer range. Remove with the Angular major migration.",
      "matchPackageNames": ["zone.js"],
      "allowedVersions": "<0.14.0"
    },
    {
      "description": "Angular 15 peer range. Remove with the Angular major migration.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<5.0.0"
    }
  ]
}
